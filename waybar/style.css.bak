/* =============================================================
   Waybar style — tema teal/dark
   Pills arredondadas sobre fundo escuro, sotaque teal/azul
   ============================================================= */

/* Paleta (baseada no visual da imagem)
   fundo barra    : #1a1b26  (dark navy)
   pill fundo     : #24283b  (slate)
   texto          : #c0caf5  (lavanda claro)
   teal/accent    : #7dcfff  (azul claro)
   verde bateria  : #9ece6a
   vermelho alerta: #f7768e
*/

* {
    font-family: "JetBrainsMono Nerd Font", "Font Awesome 6 Free";
    font-size: 13px;
    font-weight: 600;
    min-height: 0;
    /* Remove o padding/margin padrão que causa desalinhamento */
    margin: 0;
    padding: 0;
}

/* Barra principal — fundo transparente para as pills flutuarem */
window#waybar {
    background: transparent;
    color: #c0caf5;
}

/* Fundo geral da barra (o retângulo escuro) */
.modules-left,
.modules-center,
.modules-right {
    background: #1a1b26;
    border-radius: 12px;
    padding: 0 6px;
}

/* Espaçamento interno de cada módulo */
#custom-arch,
#clock,
#custom-updates,
#mpris,
#workspaces,
#custom-weather,
#pulseaudio,
#pulseaudio.microphone,
#custom-notification {
    padding: 2px 12px;
    margin: 4px 3px;
    border-radius: 10px;
    background: #24283b;
    color: #c0caf5;
}

/* =============================================================
   ESQUERDA
   ============================================================= */

/* Símbolo do Arch — destaque em azul */
#custom-arch {
    color: #7dcfff;
    font-size: 16px;
    padding: 2px 14px;
    background: #24283b;
}

#custom-arch:hover {
    background: #7dcfff;
    color: #1a1b26;
}

/* Relógio */
#clock {
    color: #c0caf5;
}

/* Updates — laranja/amarelo quando há pacotes */
#custom-updates {
    color: #e0af68;
}

/* Media/música — tom rosa suave */
#mpris {
    color: #bb9af7;
    background: #24283b;
}

#mpris.paused {
    color: #565f89;
}

/* =============================================================
   CENTRO — workspaces
   ============================================================= */

#workspaces {
    background: #1a1b26;
    padding: 0 4px;
    margin: 4px 3px;
}

#workspaces button {
    padding: 2px 10px;
    margin: 2px 2px;
    color: #565f89;
    background: #24283b;
    border-radius: 8px;
    transition: all 0.2s ease;
}

/* Workspace ativo — destaque teal */
#workspaces button.active {
    color: #1a1b26;
    background: #7dcfff;
    padding: 2px 16px;
}

#workspaces button:hover {
    background: #414868;
    color: #c0caf5;
}

/* Workspace com janela urgente */
#workspaces button.urgent {
    background: #f7768e;
    color: #1a1b26;
}

/* =============================================================
   DIREITA
   ============================================================= */

/* Clima */
#custom-weather {
    color: #7dcfff;
}

/* Microfone */
#pulseaudio.microphone {
    color: #9ece6a;
}

#pulseaudio.microphone.source-muted {
    color: #f7768e;
}

/* Volume de saída */
#pulseaudio {
    color: #7dcfff;
}

#pulseaudio.muted {
    color: #f7768e;
}

/* Notificações */
#custom-notification {
    color: #e0af68;
    padding: 2px 14px;
}

#custom-notification:hover {
    background: #e0af68;
    color: #1a1b26;
}

/* =============================================================
   Tooltips
   ============================================================= */
tooltip {
    background: #1a1b26;
    border: 1px solid #7dcfff;
    border-radius: 10px;
}

tooltip label {
    color: #c0caf5;
    padding: 4px;
}
